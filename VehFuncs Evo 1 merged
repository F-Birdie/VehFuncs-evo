namespace IVF_LightFix
{
    static const uintptr_t kExtrasCallSite = 0x71B8;
    static const uintptr_t kFrameStackOffset = 0x160;
    static const uintptr_t kFrameEbpOffset = 0x08;
    static constexpr uintptr_t ADDR_RegisterCorona = 0x6FC180;

    static DWORD gMainThreadId = 0;
    static CVector gCorrectedPos;

    static bool Rd32(uintptr_t a, uint32_t* out) {
        __try { *out = *(volatile uint32_t*)a; return true; }
        __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
    }

    static bool PlausiblePtr(uintptr_t p) {
        return p >= 0x10000 && p < 0xFFFF0000 && (p & 3) == 0;
    }

    static bool IsFrame(uintptr_t p) {
        if (!PlausiblePtr(p)) return false;
        RwFrame* f = (RwFrame*)p;
        uint32_t root = 0, rootroot = 0, parent = 0;
        if (!Rd32((uintptr_t)&f->root, &root)) return false;
        if (!PlausiblePtr(root)) return false;
        if (!Rd32((uintptr_t) & ((RwFrame*)root)->root, &rootroot)) return false;
        if (rootroot != root) return false;
        return Rd32((uintptr_t)&f->object.parent, &parent);
    }

    static bool InChildList(uintptr_t f, uintptr_t parent) {
        uint32_t c = 0;
        if (!Rd32((uintptr_t) & ((RwFrame*)parent)->child, &c)) return false;
        for (int i = 0; i < 512 && c; ++i) {
            if (c == f) return true;
            uint32_t nx = 0;
            if (!Rd32((uintptr_t) & ((RwFrame*)c)->next, &nx)) return false;
            c = nx;
        }
        return false;
    }

    static bool ReachableFromRoot(uintptr_t f, uintptr_t root) {
        for (int i = 0; i < 64; ++i) {
            if (f == root) return true;
            uint32_t par = 0;
            if (!Rd32((uintptr_t) & ((RwFrame*)f)->object.parent, &par) || par == 0) return false;
            if (!InChildList(f, par)) return false;
            f = par;
        }
        return false;
    }

    static bool IsEmptyFrame(uintptr_t f) {
        uint32_t child = 0;
        if (!Rd32((uintptr_t) & ((RwFrame*)f)->child, &child)) return true;
        if (child != 0) return false;
        uintptr_t listHead = (uintptr_t) & ((RwFrame*)f)->child - 8;
        uint32_t next = 0;
        if (!Rd32(listHead, &next)) return true;
        return next == (uint32_t)listHead;
    }

    static int Evaluate(uint32_t frame, uintptr_t clumpRoot) {
        if (!IsFrame(frame)) return 1;
        if (clumpRoot && !ReachableFromRoot(frame, clumpRoot)) return 2;
        if (!IsEmptyFrame(frame)) return 3;
        return 0;
    }

    static bool IsCarNodeName(const char* name) {
        if (!name) return false;
        return strstr(name, "bonnet_dummy") || strstr(name, "boot_dummy") ||
            strstr(name, "door_lf_dummy") || strstr(name, "door_rf_dummy") ||
            strstr(name, "door_lr_dummy") || strstr(name, "door_rr_dummy") ||
            strstr(name, "wing_lf_dummy") || strstr(name, "wing_rf_dummy") ||
            strstr(name, "bump_front_dummy") || strstr(name, "bump_rear_dummy");
    }

    static bool NestedUnderCarNode(RwFrame* frame, RwFrame* root) {
        __try {
            RwFrame* parent = (RwFrame*)frame->object.parent;
            if (!parent || parent == root) return false;
            RwFrame* p = (RwFrame*)parent->object.parent;
            for (int i = 0; i < 64 && p && p != root; ++i, p = (RwFrame*)p->object.parent)
                if (IsCarNodeName(GetFrameNodeName(p))) return true;
            return false;
        }
        __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
    }

    static bool VehicleSpacePos(RwFrame* frame, RwFrame* root, CVector* out) {
        __try {
            float x = frame->modelling.pos.x, y = frame->modelling.pos.y, z = frame->modelling.pos.z;
            RwFrame* a = (RwFrame*)frame->object.parent;
            for (int i = 0; i < 64 && a && a != root; ++i, a = (RwFrame*)a->object.parent) {
                const RwMatrix& m = a->modelling;
                float nx = m.right.x * x + m.up.x * y + m.at.x * z + m.pos.x;
                float ny = m.right.y * x + m.up.y * y + m.at.y * z + m.pos.y;
                float nz = m.right.z * x + m.up.z * y + m.at.z * z + m.pos.z;
                x = nx; y = ny; z = nz;
            }
            if (a != root) return false;
            out->x = x; out->y = y; out->z = z;
            return true;
        }
        __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
    }

    static LONG CALLBACK BreakpointHandler(PEXCEPTION_POINTERS ei) {
        if (ei->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP) return EXCEPTION_CONTINUE_SEARCH;
        if ((uintptr_t)ei->ExceptionRecord->ExceptionAddress != ADDR_RegisterCorona) return EXCEPTION_CONTINUE_SEARCH;
        if (GetCurrentThreadId() != gMainThreadId) return EXCEPTION_CONTINUE_SEARCH;

        PCONTEXT ctx = ei->ContextRecord;
        const uint32_t* sp = (const uint32_t*)ctx->Esp;

        bool drop = false;
        const uintptr_t ret = sp[0];

        HMODULE callerMod = nullptr;
        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
            GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
            (LPCSTR)ret, &callerMod) && callerMod)
        {
            uintptr_t base = (uintptr_t)callerMod;
            if ((ret - base) == kExtrasCallSite) {
                const uint32_t attach = sp[2];

                uint32_t typeWord = 0;
                if (attach && Rd32((uintptr_t)attach + 0x34, &typeWord) &&
                    ((typeWord >> 16) & 7) == 2)
                {
                    CVehicle* veh = (CVehicle*)(uintptr_t)attach;

                    uint32_t clump = 0, root = 0;
                    Rd32((uintptr_t)&veh->m_pRwClump, &clump);
                    if (clump) Rd32((uintptr_t) & ((RwObject*)(uintptr_t)clump)->parent, &root);

                    uint32_t frame = 0;
                    Rd32(ctx->Esp + kFrameStackOffset, &frame);
                    if (!IsFrame(frame)) {
                        uint32_t alt = 0;
                        if (Rd32(ctx->Ebp + kFrameEbpOffset, &alt) && IsFrame(alt)) frame = alt;
                    }

                    if (frame != 0 && root != 0) {
                        int reason = Evaluate(frame, root);
                        if (reason != 0) {
                            drop = true;
                        }
                        else if (NestedUnderCarNode((RwFrame*)(uintptr_t)frame, (RwFrame*)(uintptr_t)root) &&
                            VehicleSpacePos((RwFrame*)(uintptr_t)frame, (RwFrame*)(uintptr_t)root, &gCorrectedPos)) {
                            ((uint32_t*)ctx->Esp)[7] = (uint32_t)(uintptr_t)&gCorrectedPos;
                        }
                    }
                }
            }
        }

        if (drop) {
            ctx->Eip = (DWORD)ret;
            ctx->Esp += 4;
        }
        else {
            ctx->EFlags |= 0x10000;
        }
        return EXCEPTION_CONTINUE_EXECUTION;
    }

    struct InstallArgs { DWORD tid; bool ok; };

    // Static so the worker thread can never write into a dead stack frame,
    // even if the wait below times out.
    static InstallArgs g_installArgs;
    static bool g_installed = false;

    static DWORD WINAPI InstallThread(LPVOID p) {
        auto* args = (InstallArgs*)p;
        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_SET_CONTEXT, FALSE, args->tid);
        if (!h) return 0;
        if (SuspendThread(h) != (DWORD)-1) {
            CONTEXT c = {};
            c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
            if (GetThreadContext(h, &c)) {
                c.Dr0 = (DWORD)ADDR_RegisterCorona;
                c.Dr7 &= ~0x000F0003u;
                c.Dr7 |= 0x1;
                c.Dr6 = 0;
                args->ok = SetThreadContext(h, &c) != FALSE;
            }
            ResumeThread(h);
        }
        CloseHandle(h);
        return 0;
    }

    static void InstallBreakpoint() {
        if (g_installed) return;            // never add the handler twice
        g_installed = true;

        gMainThreadId = GetCurrentThreadId();
        AddVectoredExceptionHandler(1, BreakpointHandler);

        g_installArgs = { gMainThreadId, false };
        HANDLE t = CreateThread(nullptr, 0, InstallThread, &g_installArgs, 0, nullptr);
        if (t) { WaitForSingleObject(t, 5000); CloseHandle(t); }
    }

    class Plugin {
    public:
        Plugin() {
            Events::initGameEvent += [] {
                InstallBreakpoint();
                };
        }
    } gPlugin;
}

