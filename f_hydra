// 2) Stock jet-fume offsets (m_apJettrusParticles)
// =====================================================================

static CVector JetOffset[4] = {
    { -1.20f, -2.50f,  0.25f },
    {  1.20f, -2.50f,  0.25f },
    { -1.20f, -2.50f, -0.25f },
    {  1.20f, -2.50f, -0.25f },
};

class HydraJetFumes {
public:
    HydraJetFumes() {
        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!veh || veh->m_nModelIndex != MODEL_HYDRA)
                return;

            auto* plane = static_cast<CPlane*>(veh);
            for (int i = 0; i < 4; i++) {
                FxSystem_c* fx = plane->m_apJettrusParticles[i];
                if (!fx)
                    continue;
                RwV3d off = { JetOffset[i].x, JetOffset[i].y, JetOffset[i].z };
                fx->SetOffsetPos(&off);
            }
            };
    }
} hydraJetFumes;

