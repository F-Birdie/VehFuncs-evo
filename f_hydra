static constexpr int DUMMY_EXHAUST = 9;
static constexpr float DEG2RAD = 3.14159265f / 180.0f;

// =====================================================================
// Shared helpers
// =====================================================================

static RwFrame* FindFrameByName(RwFrame* root, const char* name) {
    if (!root || !name)
        return nullptr;
    if (const char* n = GetFrameNodeName(root)) {
        if (std::strcmp(n, name) == 0)
            return root;
    }
    for (RwFrame* c = root->child; c; c = c->next) {
        if (RwFrame* f = FindFrameByName(c, name))
            return f;
    }
    return nullptr;
}

// =====================================================================
// 1) Extra ailerons (aileron_l2 / aileron_r2, hinge end from aileron2_pos)
// =====================================================================

struct RestMat {
    bool valid = false;
    RwV3d right{}, up{}, at{}, pos{};
};

static RestMat restL, restR, restL2, restR2, restP2;

static void SaveRest(RwFrame* f, RestMat& out) {
    if (!f || out.valid)
        return;
    RwMatrix* m = RwFrameGetMatrix(f);
    if (!m)
        return;
    out.right = m->right;
    out.up = m->up;
    out.at = m->at;
    out.pos = m->pos;
    out.valid = true;
}

static RwV3d RotateAroundAxis(const RwV3d& v, const RwV3d& a, float c, float s) {
    const float dot = a.x * v.x + a.y * v.y + a.z * v.z;
    const RwV3d cr = {
        a.y * v.z - a.z * v.y,
        a.z * v.x - a.x * v.z,
        a.x * v.y - a.y * v.x
    };
    const float k = dot * (1.0f - c);
    return {
        v.x * c + cr.x * s + a.x * k,
        v.y * c + cr.y * s + a.y * k,
        v.z * c + cr.z * s + a.z * k
    };
}

// hingeEnd = position of the far end of the hinge line (the aileron2_pos dummy,
// mirrored for the left side). The frame origin is the near end.
static void CopyOrientDelta(RwFrame* src, const RestMat& srcRest,
    RwFrame* dst, const RestMat& dstRest, const RwV3d& hingeEnd) {
    if (!src || !dst || !srcRest.valid || !dstRest.valid)
        return;
    RwMatrix* sm = RwFrameGetMatrix(src);
    RwMatrix* dm = RwFrameGetMatrix(dst);
    if (!sm || !dm)
        return;

    // Stock aileron's current "up" vector expressed in its rest basis.
    // The stock aileron rotates around its local X axis, so the angle is
    // atan2(sin, cos) taken from the y/z components.
    const RwV3d u = sm->up;
    const float upY = srcRest.right.y * 0.0f; // (unused placeholder removed below)
    (void)upY;

    const float dUpY = srcRest.up.x * u.x + srcRest.up.y * u.y + srcRest.up.z * u.z;
    const float dUpZ = srcRest.at.x * u.x + srcRest.at.y * u.y + srcRest.at.z * u.z;
    const float angle = atan2f(dUpZ, dUpY);
    const float c = cosf(angle);
    const float s = sinf(angle);

    // Hinge axis: from the aileron origin to the dummy
    RwV3d axis = {
        hingeEnd.x - dstRest.pos.x,
        hingeEnd.y - dstRest.pos.y,
        hingeEnd.z - dstRest.pos.z
    };
    float len = sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
    if (len < 1e-5f) {
        axis = dstRest.right;
        len = sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
        if (len < 1e-5f)
            return;
    }
    axis.x /= len; axis.y /= len; axis.z /= len;

    // Keep the same rotation direction as the stock aileron's X axis
    if (axis.x * srcRest.right.x + axis.y * srcRest.right.y + axis.z * srcRest.right.z < 0.0f) {
        axis.x = -axis.x; axis.y = -axis.y; axis.z = -axis.z;
    }

    dm->right = RotateAroundAxis(dstRest.right, axis, c, s);
    dm->up = RotateAroundAxis(dstRest.up, axis, c, s);
    dm->at = RotateAroundAxis(dstRest.at, axis, c, s);
    dm->pos = dstRest.pos;

    RwMatrixUpdate(dm);
    RwFrameUpdateObjects(dst);
}

class AileronL2R2 {
public:
    AileronL2R2() {
        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!veh || !veh->m_pRwClump)
                return;
            if (veh->m_nModelIndex != MODEL_HYDRA)
                return;

            auto* plane = static_cast<CPlane*>(veh);
            RwFrame* al = plane->m_aCarNodes[PLANE_AILERON_L];
            RwFrame* ar = plane->m_aCarNodes[PLANE_AILERON_R];
            if (!al || !ar)
                return;

            RwFrame* root = RpClumpGetFrame(veh->m_pRwClump);
            RwFrame* l2 = FindFrameByName(root, "aileron_l2");
            RwFrame* r2 = FindFrameByName(root, "aileron_r2");
            RwFrame* p2 = FindFrameByName(root, "aileron2_pos");
            if (!l2 || !r2 || !p2)
                return;

            SaveRest(al, restL);
            SaveRest(ar, restR);
            SaveRest(l2, restL2);
            SaveRest(r2, restR2);
            SaveRest(p2, restP2);

            // aileron2_pos is always on the right (positive X); mirror it for the left
            const RwV3d hingeR = restP2.pos;
            const RwV3d hingeL = { -restP2.pos.x, restP2.pos.y, restP2.pos.z };

            CopyOrientDelta(al, restL, l2, restL2, hingeL);
            CopyOrientDelta(ar, restR, r2, restR2, hingeR);
            };
    }
} aileronL2R2;

// =====================================================================
// 2) Jet fumes
//    Front pivot: wheel_lm_dummy  + thruster_f
//    Rear pivot:  wheel_rm_dummy  + thruster_r
//    0=RF 1=LF 2=RR 3=LR
// =====================================================================

static bool GetNamedPos(RwFrame* root, const char* name, CVector& out) {
    RwFrame* f = FindFrameByName(root, name);
    if (!f)
        return false;
    RwMatrix* m = RwFrameGetMatrix(f);
    if (!m)
        return false;
    out = { m->pos.x, m->pos.y, m->pos.z };
    return true;
}

static RwV3d DeltaToOffset(const CVector& d) {
    return { d.x, d.z, -d.y };
}

class HydraJetFumes {
public:
    HydraJetFumes() {
        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!veh || veh->m_nModelIndex != MODEL_HYDRA || !veh->m_pRwClump)
                return;

            auto* plane = static_cast<CPlane*>(veh);
            RwFrame* root = RpClumpGetFrame(veh->m_pRwClump);
            if (!root)
                return;

            CVector pivotF, pivotR, thrF, thrR;
            if (!GetNamedPos(root, "wheel_lm_dummy", pivotF)) // FRONT pivot
                return;
            if (!GetNamedPos(root, "wheel_rm_dummy", pivotR)) // REAR pivot
                return;
            if (!GetNamedPos(root, "thruster_f", thrF))
                return;
            if (!GetNamedPos(root, "thruster_r", thrR))
                return;

            const CVector dF = {
                thrF.x - pivotF.x,
                thrF.y - pivotF.y,
                thrF.z - pivotF.z
            };
            const CVector dR = {
                thrR.x - pivotR.x,
                thrR.y - pivotR.y,
                thrR.z - pivotR.z
            };

            const RwV3d offs[4] = {
                DeltaToOffset(dF),                      // 0 RF
                DeltaToOffset({ -dF.x, dF.y, dF.z }), // 1 LF
                DeltaToOffset(dR),                      // 2 RR
                DeltaToOffset({ -dR.x, dR.y, dR.z }), // 3 LR
            };

            for (int i = 0; i < 4; i++) {
                FxSystem_c* fx = plane->m_apJettrusParticles[i];
                if (!fx)
                    continue;
                RwV3d off = offs[i];
                fx->SetOffsetPos(&off);
            }
            };
    }
} hydraJetFumes;


