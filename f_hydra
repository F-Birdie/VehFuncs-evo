static constexpr int DUMMY_EXHAUST = 9;
static constexpr float DEG2RAD = 3.14159265f / 180.0f;

// ===================== IDLE ========================
static constexpr float IDLE_JT_RATE = 1.0f;
static constexpr float IDLE_JT_PITCH_DEG = 0.0f;
static constexpr float IDLE_JT_CONST_TIME = 0.5f;
// ===================================================

// ===================== FULL THRUST =================
static constexpr float FULL_JT_RATE = 1.0f;
static constexpr float FULL_JT_PITCH_DEG = 0.0f;
static constexpr float FULL_JT_CONST_TIME = 0.5f;

static constexpr float FULL_NITRO_RATE = 6.0f;
static constexpr float FULL_NITRO_PITCH_DEG = 0.0f;
static constexpr float FULL_NITRO_CONST_TIME = 0.5f;

static constexpr float FULL_FLAME_SCALE = 2.0f;
static constexpr float FULL_FLAME_RATE = 1.0f;
static constexpr float FULL_FLAME_AT_Y = -1.0f;
// ===================================================

static FxSystem_c* g_fxNitro = nullptr;
static FxSystem_c* g_fxFlame = nullptr;
static FxSystem_c* g_fxJT = nullptr;
static CVehicle* g_bound = nullptr;
static RwMatrix    g_nitroParent;
static RwMatrix    g_jtParent;

static RwFrame* FindFrameByName(RwFrame* root, const char* name) {
    if (!root || !name)
        return nullptr;
    if (const char* n = GetFrameNodeName(root)) {
        if (std::strcmp(n, name) == 0)
            return root;
    }
    for (RwFrame* c = root->child; c; c = c->next) {
        if (RwFrame* f = FindFrameByName(c, name))
            return f;
    }
    return nullptr;
}

static bool GetExhaustLocalPos(CVehicle* veh, CVector& out) {
    if (veh->m_pRwClump) {
        RwFrame* root = RpClumpGetFrame(veh->m_pRwClump);
        if (RwFrame* exh = FindFrameByName(root, "exhaust")) {
            if (RwMatrix* m = RwFrameGetMatrix(exh)) {
                out = { m->pos.x, m->pos.y, m->pos.z };
                return true;
            }
        }
    }
    auto* mi = static_cast<CVehicleModelInfo*>(
        CModelInfo::GetModelInfo(veh->m_nModelIndex));
    if (mi && mi->m_pVehicleStruct) {
        out = mi->m_pVehicleStruct->m_avDummyPos[DUMMY_EXHAUST];
        return true;
    }
    return false;
}

static void KillNitroFlame() {
    if (g_fxNitro) { g_fxNitro->Kill(); g_fxNitro = nullptr; }
    if (g_fxFlame) { g_fxFlame->Kill(); g_fxFlame = nullptr; }
}

static void KillRear() {
    KillNitroFlame();
    if (g_fxJT) { g_fxJT->Kill(); g_fxJT = nullptr; }
    g_bound = nullptr;
}

static void MakeLocalOriented(RwMatrix& mat, const RwV3d& off, float scale, float atY) {
    RwMatrixSetIdentity(&mat);
    mat.right = { scale, 0.0f, 0.0f };
    mat.up = { 0.0f, 0.0f, scale };
    mat.at = { 0.0f, atY * scale, 0.0f };
    mat.pos = off;
}

static void UpdatePitchedParent(RwMatrix& outParent, RwMatrix* vehMat,
    const RwV3d& exhaustOff, float pitchDeg) {
    const float r = pitchDeg * DEG2RAD;
    const float c = cosf(r);
    const float s = sinf(r);

    const RwV3d R = vehMat->right;
    const RwV3d U = vehMat->up;
    const RwV3d A = vehMat->at;

    outParent.right = R;
    outParent.up.x = U.x * c + A.x * s;
    outParent.up.y = U.y * c + A.y * s;
    outParent.up.z = U.z * c + A.z * s;
    outParent.at.x = -U.x * s + A.x * c;
    outParent.at.y = -U.y * s + A.y * c;
    outParent.at.z = -U.z * s + A.z * c;

    outParent.pos.x = R.x * exhaustOff.x + U.x * exhaustOff.y + A.x * exhaustOff.z + vehMat->pos.x;
    outParent.pos.y = R.y * exhaustOff.x + U.y * exhaustOff.y + A.y * exhaustOff.z + vehMat->pos.y;
    outParent.pos.z = R.z * exhaustOff.x + U.z * exhaustOff.y + A.z * exhaustOff.z + vehMat->pos.z;
}

static FxSystem_c* CreateOnParent(const char* name, RwV3d* off, RwMatrix* parent,
    float scale, float atY, float rate) {
    RwMatrix local;
    MakeLocalOriented(local, *off, scale, atY);

    FxSystem_c* fx = g_fxMan.CreateFxSystem((char*)name, &local, parent, true);
    if (!fx)
        fx = g_fxMan.CreateFxSystem((char*)name, off, parent, true);
    if (!fx && parent)
        fx = g_fxMan.CreateFxSystem((char*)name, off, nullptr, true);

    if (fx) {
        fx->SetOffsetPos(off);
        fx->SetLocalParticles(true);
        fx->SetRateMult(rate);
        fx->Play();
    }
    return fx;
}

static FxSystem_c* CreatePitched(const char* name, RwV3d* exhaustOff, RwMatrix* vehMat,
    RwMatrix& parentStore, float pitchDeg, float rate, float constTime) {
    UpdatePitchedParent(parentStore, vehMat, *exhaustOff, pitchDeg);

    RwV3d zero = { 0.0f, 0.0f, 0.0f };
    FxSystem_c* fx = g_fxMan.CreateFxSystem((char*)name, &zero, &parentStore, true);
    if (!fx)
        return nullptr;

    fx->m_pParentMatrix = &parentStore;
    fx->SetOffsetPos(&zero);
    fx->SetLocalParticles(true);
    fx->SetRateMult(rate);
    fx->SetConstTime(1, constTime);
    fx->Play();
    return fx;
}

static void UpdatePitched(FxSystem_c* fx, RwV3d* exhaustOff, RwMatrix* vehMat,
    RwMatrix& parentStore, float pitchDeg, float rate, float constTime) {
    if (!fx || !vehMat)
        return;

    UpdatePitchedParent(parentStore, vehMat, *exhaustOff, pitchDeg);
    fx->m_pParentMatrix = &parentStore;

    RwV3d zero = { 0.0f, 0.0f, 0.0f };
    fx->SetOffsetPos(&zero);
    fx->SetLocalParticles(true);
    fx->SetRateMult(rate);
    fx->SetConstTime(1, constTime);
}

// CPad::GetAccelerate() — short, > 0 means gas
static bool IsHoldingGas(CVehicle* veh) {
    CVehicle* playerVeh = FindPlayerVehicle(-1, false);
    if (!playerVeh || playerVeh != veh)
        return false;

    CPad* pad = CPad::GetPad(0);
    if (!pad)
        return false;

    return pad->GetAccelerate() > 0;
}

// How far through the hover->jet nozzle sweep before the effect kicks in.
// 0.0 = trigger almost immediately (still near hover), 1.0 = only once
// fully rotated. Tune to taste.
static constexpr float JET_MODE_TRIGGER_FRACTION = 0.5f;

// Measured directly from hydra_nozzle_debug.log: angle=5000 at hover,
// angle=0 at full jet, smooth linear transition between them.
// CPlane::HARRIER_NOZZLE_ROTATE_LIMIT/SWITCH_LIMIT read as 0.000 in this
// build (their StaticRef addresses aren't resolving to real data here),
// so we use the measured constants instead rather than those broken refs.
static constexpr float NOZZLE_HOVER_ANGLE = 5000.0f;
static constexpr float NOZZLE_JET_ANGLE = 0.0f;

static bool IsInJetMode(CPlane* plane) {
    const float thresholdAngle = NOZZLE_HOVER_ANGLE
        - (NOZZLE_HOVER_ANGLE - NOZZLE_JET_ANGLE) * JET_MODE_TRIGGER_FRACTION;
    return (float)plane->m_wMiscComponentAngle <= thresholdAngle;
}

static bool IsFullThrust(CVehicle* veh) {
    auto* plane = static_cast<CPlane*>(veh);
    return IsInJetMode(plane) && IsHoldingGas(veh);
}

class HydraRearExhaustFx {
public:
    HydraRearExhaustFx() {
        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!veh || veh->m_nModelIndex != MODEL_HYDRA) {
                if (veh == g_bound)
                    KillRear();
                return;
            }

            auto* plane = static_cast<CPlane*>(veh);

            FxSystem_c* stock = nullptr;
            for (int i = 0; i < 4; i++) {
                if (plane->m_apJettrusParticles[i]) {
                    stock = plane->m_apJettrusParticles[i];
                    break;
                }
            }
            if (!stock)
                return;

            CVector local;
            if (!GetExhaustLocalPos(veh, local))
                return;

            RwV3d off = { local.x, local.y, local.z };

            CMatrix& cmat = veh->GetMatrix();
            cmat.UpdateRW();
            RwMatrix* vehMat = cmat.m_pAttachMatrix;
            if (!vehMat && veh->m_pRwClump) {
                if (RwFrame* root = RpClumpGetFrame(veh->m_pRwClump))
                    vehMat = RwFrameGetMatrix(root);
            }
            if (!vehMat)
                return;

            const bool full = IsFullThrust(veh);

            if (g_bound != veh) {
                KillRear();
                g_bound = veh;
            }

            const float jtRate = full ? FULL_JT_RATE : IDLE_JT_RATE;
            const float jtPitch = full ? FULL_JT_PITCH_DEG : IDLE_JT_PITCH_DEG;
            const float jtConst = full ? FULL_JT_CONST_TIME : IDLE_JT_CONST_TIME;

            if (!g_fxJT)
                g_fxJT = CreatePitched("jetthrust", &off, vehMat, g_jtParent,
                    jtPitch, jtRate, jtConst);
            else
                UpdatePitched(g_fxJT, &off, vehMat, g_jtParent,
                    jtPitch, jtRate, jtConst);

            if (full) {
                if (!g_fxNitro)
                    g_fxNitro = CreatePitched("nitro", &off, vehMat, g_nitroParent,
                        FULL_NITRO_PITCH_DEG, FULL_NITRO_RATE,
                        FULL_NITRO_CONST_TIME);
                else
                    UpdatePitched(g_fxNitro, &off, vehMat, g_nitroParent,
                        FULL_NITRO_PITCH_DEG, FULL_NITRO_RATE,
                        FULL_NITRO_CONST_TIME);

                if (!g_fxFlame)
                    g_fxFlame = CreateOnParent("flame", &off, vehMat,
                        FULL_FLAME_SCALE, FULL_FLAME_AT_Y,
                        FULL_FLAME_RATE);
                else {
                    g_fxFlame->SetOffsetPos(&off);
                    g_fxFlame->SetRateMult(FULL_FLAME_RATE);
                }
            }
            else {
                KillNitroFlame();
            }
            };

        Events::vehicleDtorEvent += [](CVehicle* veh) {
            if (veh == g_bound)
                KillRear();
            };
    }
} hydraRearExhaustFx;
