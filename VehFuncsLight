class VehFuncsLight
{
public:
    VehFuncsLight()
    {
        // Junior: digit-terminated paintjobs (artict1_1.txd, nrg500_1.txd, …)
        // MUST be at construction time — TXD remap assign runs during game load,
        // before initScriptsEvent.
        patch::RedirectCall(0x5B62C2, CustomAssignRemapTxd, true);

        // Junior: keep f_* / extra frames during hierarchy preprocess
        MakeJMP(0x004C8E30, CustomCollapseFramesCB);

        // Junior: Hitch — CAutomobile
        int* vmt = (int*)0x00871120;
        int* getlink = vmt + (0xF0 / sizeof(vmt));
        Hitch::GetTowBarPosOriginal = (GetTowBarPos_t)ReadMemory<int*>(getlink, true);
        WriteMemory(getlink, memory_pointer(Hitch::GetTowBarPosToHook).as_int(), true);

        // Junior: Hitch — CTrailer
        Hitch::GetTowBarPosOriginal_Trailer = (GetTowBarPos_t)ReadMemory<int*>(0x871D18, true);
        WriteMemory(0x871D18, memory_pointer(Hitch::GetTowBarPosToHook).as_int(), true);

        // Junior: ug_dummy hierarchy id fix
        MakeInline<0x004C8FA1, 0x004C8FA1 + 6>([](reg_pack& regs)
            {
                if (regs.eax == 0) regs.eax = 1;
                *(uint32_t*)(regs.esp + 0x64 - 0x34) = regs.eax;
                regs.eax = *(uint32_t*)regs.edx;
            });

        // Junior: FillFrameArray hierarchy id clamp
        patch::RedirectCall(0x004C5396, CheckCrashFillFrameArrayCB, true);

        // Junior: frame plugin (FRAME_EXTENSION)
        Events::attachRwPluginsEvent += []
            {
                FramePluginOffset = RwFrameRegisterPlugin(
                    sizeof(FramePlugin), PLUGIN_ID_STR,
                    (RwPluginObjectConstructor)FramePlugin::Init,
                    (RwPluginObjectDestructor)FramePlugin::Destroy,
                    (RwPluginObjectCopy)FramePlugin::Copy);
            };

        Events::initScriptsEvent.before += []
            {
                // Junior: TXD streaming base for paintjob remap load
                txdIndexStart = ReadMemory<uint32_t>(0x6D65D2 + 1, true);

                AtomicAlphaCallBack = ReadMemory<uintptr_t>(0x4C7842, false);

                // Junior: find damage atomics walk
                MakeCALL(0x4C9173, FindDamage::CustomFindDamageAtomics, true);
                WriteMemory<uint32_t>(0x4C916D + 1, (uint32_t)(uintptr_t)&FindDamage::CustomFindDamageAtomicsCB, true);

                // Junior: NeverRender for bNeverRender (var wheels when tuning wheel installed)
                MakeNOP(0x00749B3E, 9, true);
                MakeJMP(0x00749B3E, NeverRender);

                // Junior: when wheel/other upgrades are added or removed, hide/show var-wheel clones
                MakeCALL(0x006D386C, CustomRwFrameForAllChildren_AddUpgrade);
                MakeCALL(0x006D3A18, CustomRwFrameForAllChildren_RemoveUpgrade);

                // Junior: mark upgrade exhaust/wheel frames for destroy-on-remove
                MakeInline<0x006D3746, 0x006D3746 + 5>([](reg_pack& regs)
                    {
                        regs.ecx = 0x3F800000; // original code
                        RwFrame* frame = (RwFrame*)regs.edi;
                        FRAME_EXTENSION(frame)->flags.bDestroyOnRemoveUpgrade = true;
                    });
                MakeInline<0x006D3539, 0x006D3539 + 5>([](reg_pack& regs)
                    {
                        regs.esi = regs.eax;
                        regs.edi = *(uintptr_t*)(regs.esi + 0x4);
                        RwFrame* frame = (RwFrame*)regs.edi;
                        FRAME_EXTENSION(frame)->flags.bDestroyOnRemoveUpgrade = true;
                    });

                // Junior: mark upgrades updated (spoiler hide/show)
                MakeInline<0x006E32AB, 0x006E32AB + 8>([](reg_pack& regs)
                    {
                        *(uint32_t*)(regs.esp + 0x14) = 0xFFFFFFFF;
                        CVehicle* veh = (CVehicle*)regs.edi;
                        xData.Get(veh).flags.bUpgradesUpdated = 1;
                    });
                MakeInline<0x006DF96C, 0x006DF96C + 6>([](reg_pack& regs)
                    {
                        regs.eax = *(uint16_t*)(regs.esi + 0x12);
                        regs.esi = regs.eax;
                        CVehicle* veh = (CVehicle*)regs.edi;
                        xData.Get(veh).flags.bUpgradesUpdated = 1;
                    });

                // Junior: Popup lights — suppress corona until popup rotation
                // has actually finished (real address 0x006E1CD4)
                MakeInline<0x006E1CD4, 0x006E1CD4 + 6>([](reg_pack& regs)
                    {
                        regs.eax = *(uint32_t*)(regs.esi + 0x590); // original instruction

                        CVehicle* veh = (CVehicle*)regs.esi;
                        ExtendedData& xdata = xData.Get(veh);

                        if (xdata.popupFrame[0] != nullptr)
                        {
                            bool noLights = false;
                            CAutomobile* automobile = (CAutomobile*)veh;

                            if (automobile->m_damageManager.GetLightStatus((eLights)0)) // LIGHT_FRONT_LEFT smashed
                            {
                                if (xdata.popupProgress[1] != 1.0f)
                                    noLights = true;
                            }
                            else if (automobile->m_damageManager.GetLightStatus((eLights)1)) // LIGHT_FRONT_RIGHT smashed
                            {
                                if (xdata.popupProgress[0] != 1.0f)
                                    noLights = true;
                            }
                            else
                            {
                                if (xdata.popupProgress[0] != 1.0f && xdata.popupProgress[1] != 1.0f)
                                    noLights = true;
                            }

                            if (noLights)
                                *(uint32_t*)(regs.esp - 0x4) = 0x6E28EF; // skip past corona render
                        }
                    });
            };

        // Junior: restore collapse call-site if IVF (or similar) redirected it
        Events::initScriptsEvent.after += []
            {
                static bool once = false;
                if (once) return;
                once = true;
                if (ReadMemory<uint32_t>(0x004C9148, true) != 0x004C8E30)
                    WriteMemory(0x004C9148, (int)0x004C8E30, true);
            };

        Events::vehicleSetModelEvent += [](CVehicle* vehicle, int)
            {
                ExtendedData& d = xData.Get(vehicle);
                d.nodesProcess = true;
                if (d.randomSeed == 0)
                    d.randomSeed = rand();
                d.randomSeedUsage = 0;
                memset(d.wheelFrame, 0, sizeof(d.wheelFrame));
                d.hitchFrame = nullptr;   // <-- add this
                d.spoilerFrames.clear();
                d.color[0] = d.color[1] = d.color[2] = d.color[3] = -1;
                d.paintjob = -1;
                d.popupFrame[0] = d.popupFrame[1] = nullptr;
                d.popupProgress[0] = d.popupProgress[1] = 0.0f;
                d.flags.bPreservePaintjobColor = 0;
                d.flags.bUpgradesUpdated = 1;
            };

        Events::vehicleRenderEvent.before += [](CVehicle* vehicle)
            {
                if (!vehicle || !vehicle->m_pRwClump) return;
                ExtendedData& d = xData.Get(vehicle);

                if (d.nodesProcess)
                {
                    getClassList().clear();
                    d.randomSeedUsage = 0;

                    RwFrame* root = (RwFrame*)vehicle->m_pRwClump->object.parent;
                    if (root)
                        FindNodesRecursive(root, vehicle);

                    // Junior: apply variable wheels after node walk
                    if (d.wheelFrame[0])
                        SetWheel(d.wheelFrame, vehicle);

                    // Junior: apply _cl= colors once
                    SetCharacteristicsInRender(vehicle);

                    d.nodesProcess = false;
                    d.flags.bUpgradesUpdated = 1; // first-time spoiler visibility
                }

                // Junior: popup headlights (every frame while frames exist)
                if (d.popupFrame[0] || d.popupFrame[1])
                    ProcessPopup(vehicle, &d);

                // Junior: hide f_spoiler when tuning spoiler is installed
                if (d.flags.bUpgradesUpdated)
                    ProcessSpoiler(vehicle, d.spoilerFrames, false);
            };

        Events::vehicleRenderEvent.after += [](CVehicle* vehicle)
            {
                if (!vehicle) return;
                ExtendedData& d = xData.Get(vehicle);
                if (d.flags.bUpgradesUpdated)
                {
                    ProcessSpoiler(vehicle, d.spoilerFrames, true);
                    d.flags.bUpgradesUpdated = 0;
                }
            };
    }
} vehFuncsLight;



extern "C" __declspec(dllexport) void Ext_SetCarSeed(CVehicle* vehicle, int seed)
{
    if (!vehicle) return;
    ExtendedData& d = xData.Get(vehicle);
    d.randomSeed = seed;
    d.randomSeedUsage = 0;
    d.nodesProcess = true;
}

extern "C" __declspec(dllexport) int Ext_GetCarSeed(CVehicle* vehicle)
{
    if (!vehicle) return 0;
    return xData.Get(vehicle).randomSeed;
}
