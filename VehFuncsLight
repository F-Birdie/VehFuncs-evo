static unsigned int FramePluginOffset = 0;
#define PLUGIN_ID_STR 'VEHF'
#define FRAME_EXTENSION(frame) ((FramePlugin*)((unsigned int)(frame) + FramePluginOffset))

struct FramePlugin
{
    void* origMatrix; // MatrixBackup*
    CVehicle* owner;
    int8_t LODdist;
    struct {
        unsigned char bNeverRender : 1;
        unsigned char bIsVarWheel : 1;
        unsigned char bDestroyOnRemoveUpgrade : 1;
    } flags;

    static RwFrame* Init(RwFrame* frame)
    {
        FRAME_EXTENSION(frame)->owner = nullptr;
        FRAME_EXTENSION(frame)->origMatrix = nullptr;
        FRAME_EXTENSION(frame)->flags.bNeverRender = false;
        FRAME_EXTENSION(frame)->flags.bIsVarWheel = false;
        FRAME_EXTENSION(frame)->flags.bDestroyOnRemoveUpgrade = false;
        FRAME_EXTENSION(frame)->LODdist = -100;
        return frame;
    }
    static RwFrame* Destroy(RwFrame* frame)
    {
        if (FRAME_EXTENSION(frame)->origMatrix)
        {
            delete (MatrixBackup*)FRAME_EXTENSION(frame)->origMatrix;
            FRAME_EXTENSION(frame)->origMatrix = nullptr;
        }
        return frame;
    }
    static RwFrame* Copy(RwFrame* copy, RwFrame*)
    {
        return copy;
    }
};

static void RestoreMatrixBackup(RwMatrix* dest, MatrixBackup* backup)
{
    if (!backup || !dest) return;
    dest->at = backup->at;
    dest->pos = backup->pos;
    dest->right = backup->right;
    dest->up = backup->up;
    RwMatrixUpdate(dest);
}

static bool CreateMatrixBackup(RwFrame* frame)
{
    MatrixBackup* backup = new MatrixBackup();
    if (!backup)
    {
        FRAME_EXTENSION(frame)->origMatrix = nullptr;
        return false;
    }
    RwMatrix* origin = &frame->modelling;
    backup->at = origin->at;
    backup->pos = origin->pos;
    backup->right = origin->right;
    backup->up = origin->up;
    FRAME_EXTENSION(frame)->origMatrix = backup;
    return true;
}


