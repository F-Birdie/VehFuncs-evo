static void RemoveFrameClassFromNormalArray(RwFrame* frameClass, RwFrame* frameArray[])
{
    for (int i = 0; i < 32; i++)
    {
        if (frameArray[i] == frameClass)
        {
            frameArray[i] = nullptr;
            return;
        }
    }
}

static bool FrameIsOtherClass(RwFrame* frame)
{
    string name = GetFrameNodeName(frame);
    name = name.substr(0, 24);
    size_t found = name.find("[");
    if (found != string::npos)
    {
        list<string>& classList = getClassList();
        if (classList.size() > 0)
        {
            for (list<string>::iterator it = classList.begin(); it != classList.end(); ++it)
            {
                size_t foundclass = name.find(*it);
                if (foundclass != string::npos)
                    return false;
            }
        }
        return true;
    }
    return false;
}

// forward — defined later with other characteristics helpers
static void FindVehicleCharacteristicsFromNode(RwFrame* frame, CVehicle* vehicle);

// ============================================================
// Junior ProcessClassesRecursive — without '?' conditions
// ============================================================

static void ProcessClassesRecursive(RwFrame* frame, CVehicle* vehicle, bool bSubclass)
{
    ExtendedData& xdata = xData.Get(vehicle);

    string name = GetFrameNodeName(frame);
    name = name.substr(0, 24);

    vector<RwFrame*> classNodes;
    vector<int> classNodesPercent;

    if (name.find("_reset") != string::npos)
        getClassList().clear();

    RwFrame* tempNode = frame->child;
    if (!tempNode) return;

    if (!bSubclass)
    {
        srand(xdata.randomSeed + xdata.randomSeedUsage);
        xdata.randomSeedUsage++;
    }

    int selectVariations = 1;
    bool randomizeVariations = false;

    size_t found = name.find(":");
    if (found != string::npos && name.length() > found)
    {
        selectVariations = stoi(&name[found + 1]);
        int i = 0;
        do {
            if (name.length() > (found + 1 + i))
            {
                if (name[found + 2 + i] == '+')
                    randomizeVariations = true;
            }
            i++;
        } while (i <= 1);
    }

    int totalClass = 0;
    while (tempNode)
    {
        string tempNodeName = GetFrameNodeName(tempNode);
        tempNodeName = tempNodeName.substr(0, 24);

        // Junior: '!' node = characteristics container (not a class option)
        // Process all children for _pj= / _cl= etc., then skip as class candidate
        if (!tempNodeName.empty() && tempNodeName[0] == '!')
        {
            RwFrame* tempCharacFrame = tempNode->child;
            while (tempCharacFrame)
            {
                FindVehicleCharacteristicsFromNode(tempCharacFrame, vehicle);
                tempCharacFrame = tempCharacFrame->next;
            }
            tempNode = tempNode->next;
            continue;
        }
        // '?' conditions not supported in Light
        if (tempNodeName.find('?') != string::npos)
        {
            tempNode = tempNode->next;
            continue;
        }

        size_t foundDigit = tempNodeName.find("[");
        if (foundDigit != string::npos)
            classNodesPercent.push_back(stoi(&tempNodeName[foundDigit + 1]));
        else
            classNodesPercent.push_back(100);

        classNodes.push_back(tempNode);
        totalClass++;
        tempNode = tempNode->next;
    }

    if (totalClass <= 0) return;

    if (randomizeVariations)
        selectVariations = Random(selectVariations, totalClass);
    else if (selectVariations > totalClass)
        selectVariations = totalClass;



    int i = 0;
    while (i < selectVariations)
    {
        int random = Random(0, totalClass - 1);
        if (!classNodes[random]) continue;

        if (classNodesPercent[random] != 100)
        {
            if (Random(1, 100) > classNodesPercent[random])
                continue;
        }


        // Junior: characteristics embedded in the selected class name (_pj=, _cl=, ...)
        FindVehicleCharacteristicsFromNode(classNodes[random], vehicle);

        if (classNodes[random]->child)
            ProcessClassesRecursive(classNodes[random], vehicle, true);

        // Junior class name strip
        string className = GetFrameNodeName(classNodes[random]);
        className = className.substr(0, 24);

        size_t found1 = className.find_first_of("_");
        size_t found2 = className.find_first_of("[");
        size_t found3 = className.find_first_of(":");
        if (found1 != string::npos || found2 != string::npos || found3 != string::npos)
        {
            size_t cutPos = string::npos;
            if (found1 != string::npos) cutPos = found1;
            if (found2 != string::npos && (cutPos == string::npos || found2 < cutPos)) cutPos = found2;
            if (found3 != string::npos && (cutPos == string::npos || found3 < cutPos)) cutPos = found3;
            if (cutPos != string::npos)
            {
                string classNameFixed = className.substr(0, cutPos);
                if (classNameFixed.length() > 0)
                {
                    getClassList().push_back(classNameFixed);
                }
            }
        }
        else
        {
            getClassList().push_back(className);
        }

        classNodes[random] = nullptr;
        i++;
    }
}

// ============================================================
// Junior ProcessExtraRecursive — exact
// ============================================================

static void ProcessExtraRecursive(RwFrame* frame, CVehicle* vehicle)
{
    string name = GetFrameNodeName(frame);
    name = name.substr(0, 24);

    RwFrame* tempFrame = frame->child;
    if (tempFrame != nullptr)
    {
        int selectVariations = -1;
        bool randomizeVariations = false;

        size_t found = name.find(":");
        if (found != string::npos)
        {
            if (name.length() > found)
            {
                selectVariations = stoi(&name[found + 1]);
                int i = 0;
                do {
                    if (name.length() > (found + 1 + i))
                    {
                        if (name[found + 2 + i] == '+')
                            randomizeVariations = true;
                    }
                    i++;
                } while (i <= 1);
            }
        }

        int frames = 0;
        int classFrames = 0;
        RwFrame* extraFrames[33];
        RwFrame* extraFramesMatchClass[33];
        memset(extraFrames, 0, sizeof(extraFrames));
        memset(extraFramesMatchClass, 0, sizeof(extraFramesMatchClass));

        while (frames < 32)
        {
            if (tempFrame != nullptr)
            {
                list<string>& classList = getClassList();
                if (classList.size() > 0)
                {
                    string tempFrameName = GetFrameNodeName(tempFrame);
                    tempFrameName = tempFrameName.substr(0, 24);
                    int startStringSearchIndex = 0;
                    int tempFrameNameLength = (int)tempFrameName.length();
                    do {
                        size_t foundOpen = tempFrameName.find_first_of("[", startStringSearchIndex + 1);
                        if (foundOpen != string::npos)
                        {
                            size_t foundClose = tempFrameName.find_first_of("]", foundOpen + 1);
                            if (foundClose != string::npos)
                            {
                                string frameClass = tempFrameName.substr(foundOpen + 1, foundClose - (foundOpen + 1));
                                for (list<string>::iterator it = classList.begin(); it != classList.end(); ++it)
                                {
                                    string className = (string)*it;
                                    if (frameClass.length() == className.length() && strcmp(&frameClass[0], &className[0]) == 0)
                                    {
                                        extraFramesMatchClass[classFrames] = tempFrame;
                                        classFrames++;
                                        break;
                                    }
                                }
                                startStringSearchIndex = (int)foundClose;
                            }
                            else break;
                        }
                        else break;
                    } while ((tempFrameNameLength - 2) > startStringSearchIndex);
                }
                extraFrames[frames] = tempFrame;
                frames++;
            }
            else break;
            tempFrame = tempFrame->next;
        }

        if (randomizeVariations == true)
            selectVariations = Random(selectVariations, frames);
        else
            if (selectVariations > frames) selectVariations = frames;

        extraFrames[(frames + 1)] = (RwFrame*)1;
        extraFramesMatchClass[(classFrames + 1)] = (RwFrame*)1;

        if (classFrames > 0)

            if (selectVariations == -1)
            {
                if (frames == 1) selectVariations = 0;
                else selectVariations = 1;
            }

        int i = 0;
        int random = 0;
        int loopClassFrames = classFrames;
        do {
            if (selectVariations == 0)
            {
                if (Random(0, frames) == 0) break;
            }
            if (loopClassFrames > 0)
            {
                random = Random(0, classFrames - 1);
                if (extraFramesMatchClass[random] != nullptr)
                {
                    i++;
                    ProcessExtraRecursive(extraFramesMatchClass[random], vehicle);

                    RemoveFrameClassFromNormalArray(extraFramesMatchClass[random], extraFrames);
                    extraFramesMatchClass[random] = nullptr;

                    loopClassFrames--;
                }
            }
            else
            {
                if (frames > 1) random = Random(0, frames - 1);
                if (extraFrames[random] != nullptr)
                {
                    if (FrameIsOtherClass(extraFrames[random]))
                    {
                        DestroyNodeHierarchyRecursive(extraFrames[random]);
                        extraFrames[random] = nullptr;
                        continue;
                    }
                    i++;
                    ProcessExtraRecursive(extraFrames[random], vehicle);

                    extraFrames[random] = nullptr;
                }
                else
                {
                    int k = 0;
                    for (k = 0; k < frames; k++)
                    {
                        if (extraFrames[k] != nullptr) break;
                    }
                    if (k == frames)
                    {
                        break;
                    }
                }
            }
        } while (i < selectVariations);

        // Delete all not selected nodes — Junior exact
        for (int j = 0; j < 33; j++)
        {
            if (extraFrames[j] == (RwFrame*)1) break;
            if (extraFrames[j] != nullptr && extraFrames[j] != 0)
                DestroyNodeHierarchyRecursive(extraFrames[j]);
        }
    }
}

// ============================================================
// Junior Variable Wheels (SetWheel / CloneNode)
// Wiki: [EN] Variable Wheels — f_wheel_**** binary mask
// ============================================================

static bool createCloneNoRender = false;

// Clone hierarchy under parent (Junior Utilities.cpp)
static void CloneNode(RwFrame* frame, RpClump* clump, RwFrame* parent, bool isRoot, bool isVarWheel)
{
    if (!frame) return;

    if (isVarWheel)
        FRAME_EXTENSION(frame)->flags.bIsVarWheel = true;

    if (isRoot)
    {
        // rarely used for wheels; clone children onto parent
        if (RwFrame* nextFrame = frame->child)
            CloneNode(nextFrame, clump, parent, false, isVarWheel);
        return;
    }

    RwFrame* newFrame = RwFrameCreate();
    memcpy(&newFrame->modelling, &frame->modelling, sizeof(RwMatrix));
    RwMatrixUpdate(&newFrame->modelling);

    const string frameName = GetFrameNodeName(frame);
    SetFrameNodeName(newFrame, frameName.c_str());

    RpAtomic* atomic = (RpAtomic*)GetFirstObject(frame);
    if (atomic)
    {
        RpAtomic* newAtomic = RpAtomicClone(atomic);
        RpAtomicSetFrame(newAtomic, newFrame);
        RpClumpAddAtomic(clump, newAtomic);
    }

    RwFrameAddChild(parent, newFrame);

    // Mark the CLONE so upgrade add/remove can find var-wheel meshes later
    if (isVarWheel)
        FRAME_EXTENSION(newFrame)->flags.bIsVarWheel = true;

    if (createCloneNoRender)
        FRAME_EXTENSION(newFrame)->flags.bNeverRender = true;

    if (RwFrame* nextFrame = frame->child)
        CloneNode(nextFrame, clump, newFrame, false, isVarWheel);
    if (RwFrame* nextFrame = frame->next)
        CloneNode(nextFrame, clump, parent, false, isVarWheel);
}

static int CVehicle__GetReplacementUpgrade(CVehicle* _this, int nodeId)
{
    return ((int(__thiscall*)(CVehicle*, int))0x6D3A50)(_this, nodeId);
}

// Junior SetWheel — exact logic
static void SetWheel(RwFrame* frame[6], CVehicle* vehicle)
{
    createCloneNoRender = false;
    bool hasTuningWheel = CVehicle__GetReplacementUpgrade(vehicle, 2) != -1;

    for (int j = 0; j < 6; j++)
    {
        if (!frame[j])
            continue;

        if (frame[j]->object.parent && FRAME_EXTENSION(frame[j])->owner == vehicle)
        {
            const string name = GetFrameNodeName(frame[j]);
            // f_wheel_******  positions 8..13 are the RF RB LB LF RM LM flags
            for (int i = 8; i <= 13; i++)
            {
                if (i >= (int)name.length() || name[i] == '\0' || name[i] == ':' || name[i] == '?')
                    break;
                if (name[i] != '1')
                    continue;

                int wheelId = 0;
                int subClass = vehicle->m_nVehicleSubClass;
                switch (i)
                {
                case 8:
                    if (subClass == 9 || subClass == 10) wheelId = 4;
                    else wheelId = CAR_WHEEL_RF;
                    break;
                case 9:
                    if (subClass == 9 || subClass == 10) wheelId = 5;
                    else wheelId = CAR_WHEEL_RB;
                    break;
                case 10:
                    wheelId = CAR_WHEEL_LB;
                    break;
                case 11:
                    wheelId = CAR_WHEEL_LF;
                    break;
                case 12:
                    wheelId = CAR_WHEEL_RM;
                    break;
                case 13:
                    wheelId = CAR_WHEEL_LM;
                    break;
                default:
                    wheelId = 0;
                    break;
                }

                if (!wheelId)
                    continue;

                RwFrame* wheelFrame = nullptr;
                if (subClass == 9 || subClass == 10)
                    wheelFrame = CClumpModelInfo::GetFrameFromId(vehicle->m_pRwClump, wheelId);
                else
                    wheelFrame = reinterpret_cast<CAutomobile*>(vehicle)->m_aCarNodes[wheelId];

                if (wheelFrame && frame[j]->child)
                {
                    createCloneNoRender = hasTuningWheel;
                    CloneNode(frame[j]->child, vehicle->m_pRwClump, wheelFrame, false, true);
                    createCloneNoRender = false;
                    CVisibilityPlugins::SetFrameHierarchyId(frame[j]->child, wheelId);
                }
            }

            if (frame[j]->child)
                DestroyNodeHierarchyRecursive(frame[j]->child);
            RwFrameDestroy(frame[j]);
            frame[j] = nullptr;   // add this
            continue;
        }

        ExtendedData& xdata = xData.Get(vehicle);
        xdata.wheelFrame[j] = nullptr;
    }
}

// ============================================================
// Upgrade add/remove — ONLY touch variable-wheel clones (bIsVarWheel).
// Full Junior path also walks fog/exhaust upgrade trees with RemoveObjectsCB;
// that was crashing on cancel-preview for non-wheel upgrades.
// ============================================================

static RpAtomic* __cdecl SafeRemoveAtomicCB(RpAtomic* atomic, void* data)
{
    (void)data;
    if (!atomic) return nullptr;
    if (atomic->clump)
        RpClumpRemoveAtomic(atomic->clump, atomic);
    RpAtomicDestroy(atomic);
    return nullptr;
}

static RwFrame* __cdecl CustomRwFrameForAllChildren_AddUpgrade_Recurse(RwFrame* frame, void* data)
{
    (void)data;
    // Only hide variable-wheel clones — do not touch fog/exhaust/other frames
    if (FRAME_EXTENSION(frame)->flags.bIsVarWheel)
        FRAME_EXTENSION(frame)->flags.bNeverRender = true;

    if (RwFrame* c = frame->child)
        CustomRwFrameForAllChildren_AddUpgrade_Recurse(c, data);
    if (RwFrame* n = frame->next)
        CustomRwFrameForAllChildren_AddUpgrade_Recurse(n, data);
    return frame;
}

static RwFrame* __cdecl CustomRwFrameForAllChildren_AddUpgrade(RwFrame* frame, RwFrame* (__cdecl* callback)(RwFrame*, void*), void* data)
{
    (void)callback;
    if (RwFrame* c = frame->child)
        CustomRwFrameForAllChildren_AddUpgrade_Recurse(c, data);
    return frame;
}

static RwFrame* __cdecl CustomRwFrameForAllChildren_RemoveUpgrade_Recurse(RwFrame* frame, void* data)
{
    if (FRAME_EXTENSION(frame)->flags.bDestroyOnRemoveUpgrade)
    {
        // Upgrade-owned meshes: strip atomics safely (data may be clump; use atomic->clump)
        RwFrameForAllObjects(frame, (RwObjectCallBack)SafeRemoveAtomicCB, data);
    }
    else if (FRAME_EXTENSION(frame)->flags.bIsVarWheel)
    {
        // Show variable wheels again after cancel / remove upgrade
        FRAME_EXTENSION(frame)->flags.bNeverRender = false;
    }

    RwFrameForAllChildren(frame, CustomRwFrameForAllChildren_RemoveUpgrade_Recurse, data);
    return frame;
}

static RwFrame* __cdecl CustomRwFrameForAllChildren_RemoveUpgrade(RwFrame* frame, RwFrame* (__cdecl* callback)(RwFrame*, void*), void* data)
{
    (void)callback;
    RwFrameForAllChildren(frame, CustomRwFrameForAllChildren_RemoveUpgrade_Recurse, data);
    return frame;
}

// Junior NeverRender — hide frames with bNeverRender (tuning-wheel clones)
static int neverRenderValid = 1;

static void __cdecl NeverRenderCheck(RpAtomic* atomic)
{
    RwFrame* frame = (RwFrame*)atomic->object.object.parent;
    if (frame && FRAME_EXTENSION(frame)->flags.bNeverRender)
    {
        neverRenderValid = 0;
        return;
    }
    neverRenderValid = 1;
}

static void __declspec(naked) NeverRender()
{
    __asm {
        push edi
        call NeverRenderCheck
        add esp, 4
        mov eax, [edi + 4]
        push eax
        mov edx, 0x7F0990
        call edx
        cmp neverRenderValid, 1
        je NeverRender_IsValid
        add esp, 4
        push 0x749B4E
        ret
        NeverRender_IsValid :
        push 0x749B47
            ret
    }
}

// ============================================================
// Junior f_spoiler — hide when spoiler upgrade (slot 6) is installed
// (no speed animation; that is separate f_an logic we skip)
// ============================================================

static RwFrame* HideAllNodesRecursive_Forced(RwFrame* frame, bool isRoot)
{
    FRAME_EXTENSION(frame)->flags.bNeverRender = true;
    if (RwFrame* nextFrame = frame->child)
        HideAllNodesRecursive_Forced(nextFrame, false);
    if (!isRoot)
        if (RwFrame* nextFrame = frame->next)
            HideAllNodesRecursive_Forced(nextFrame, false);
    return frame;
}

static RwFrame* ShowAllNodesRecursive_Forced(RwFrame* frame, bool isRoot)
{
    FRAME_EXTENSION(frame)->flags.bNeverRender = false;
    if (RwFrame* nextFrame = frame->child)
        ShowAllNodesRecursive_Forced(nextFrame, false);
    if (!isRoot)
        if (RwFrame* nextFrame = frame->next)
            ShowAllNodesRecursive_Forced(nextFrame, false);
    return frame;
}

// Junior Spoiler.cpp — exact (tuning hide only)
static void ProcessSpoiler(CVehicle* vehicle, list<RwFrame*> frames, bool after)
{
    if (frames.empty())
        return;

    bool visible = true;

    if (vehicle->GetUpgrade(6) > 0) // spoiler upgrade slot
    {
        visible = false;
    }
    else
    {
        if (after)
            visible = true;
        else
            return;
    }

    for (RwFrame* frame : frames)
    {
        if (frame->object.parent && FRAME_EXTENSION(frame)->owner == vehicle)
        {
            if (!visible)
                HideAllNodesRecursive_Forced(frame, true);
            else
                ShowAllNodesRecursive_Forced(frame, true);
        }
    }
}

// ============================================================
// Junior popup headlights — f_popl / f_popr
// Syntax: f_popl=ax45z10s2  (a=axis rotation, xyz=translate*0.01, s=speed)
// ============================================================

static void ProcessPopup(CVehicle* vehicle, ExtendedData* xdata)
{
    float speed = 0.0f;
    float ax = 30.0f, ay = 0.0f, az = 0.0f;
    float x = 0.0f, y = 0.0f, z = 0.0f;

    for (int i = 0; i < 2; i++)
    {
        if (xdata->popupFrame[i] == nullptr)
            continue;

        RwFrame* frame = xdata->popupFrame[i];
        if (!(frame->object.parent && FRAME_EXTENSION(frame)->owner == vehicle))
        {
            xdata->popupFrame[i] = nullptr;
            xdata->popupProgress[i] = 0.0f;
            continue;
        }

        const string name = GetFrameNodeName(frame);

        // Parse f_pop?=ax.. (name[6] == '=')
        if (name.length() > 6 && name[6] == '=')
        {
            speed = 0.0f;
            ax = ay = az = 0.0f;
            x = y = z = 0.0f;
            for (unsigned int j = 7; j < name.length(); j++)
            {
                switch (name[j])
                {
                case 'a':
                    if (j + 1 < name.length())
                    {
                        switch (name[j + 1])
                        {
                        case 'x': ax = (float)atof(&name[j + 2]); break;
                        case 'y': ay = (float)atof(&name[j + 2]); break;
                        case 'z': az = (float)atof(&name[j + 2]); break;
                        }
                    }
                    break;
                case 's':
                    speed = (float)atof(&name[j + 1]) * (CTimer::ms_fTimeStep * 1.66666f) * 0.005f;
                    break;
                case 'x':
                    if (j > 0 && name[j - 1] == 'a') break;
                    x = (float)atof(&name[j + 1]) * 0.01f;
                    break;
                case 'y':
                    if (j > 0 && name[j - 1] == 'a') break;
                    y = (float)atof(&name[j + 1]) * 0.01f;
                    break;
                case 'z':
                    if (j > 0 && name[j - 1] == 'a') break;
                    z = (float)atof(&name[j + 1]) * 0.01f;
                    break;
                }
                if (name[j] == '_') break;
            }
        }

        if (speed == 0.0f)
            speed = 4.0f * (CTimer::ms_fTimeStep * 1.66666f) * 0.005f;

        // Lights on/off (plugin-sdk: bLightsOn, not m_nVehicleFlags)
        bool lightsOn;
        if (vehicle->bLightsOn || vehicle->m_nOverrideLights == 2)
        {
            if (xdata->popupProgress[i] == 1.0f) continue;
            lightsOn = true;
        }
        else
        {
            if (xdata->popupProgress[i] == 0.0f) continue;
            lightsOn = false;
        }

        // Skip if that headlight is smashed (Junior)
        CAutomobile* automobile = reinterpret_cast<CAutomobile*>(vehicle);
        // LIGHT_FRONT_LEFT=0, LIGHT_FRONT_RIGHT=1
        if (i == 1 && automobile->m_damageManager.GetLightStatus((eLights)1)) continue;
        if (i == 0 && automobile->m_damageManager.GetLightStatus((eLights)0)) continue;

        if (lightsOn)
            xdata->popupProgress[i] += speed;
        else
            xdata->popupProgress[i] -= speed;

        RestoreMatrixBackup(&frame->modelling, (MatrixBackup*)FRAME_EXTENSION(frame)->origMatrix);

        float progress = xdata->popupProgress[i];
        if (progress >= 1.0f)
        {
            xdata->popupProgress[i] = 1.0f;
            RwV3d vec = { x, y, z };
            RwFrameTranslate(frame, &vec, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E00, ax, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E0C, ay, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E18, az, rwCOMBINEPRECONCAT);
        }
        else if (progress <= 0.0f)
        {
            xdata->popupProgress[i] = 0.0f;
            RwV3d vec = { 0, 0, 0 };
            RwFrameTranslate(frame, &vec, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E00, 0, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E0C, 0, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E18, 0, rwCOMBINEPRECONCAT);
        }
        else
        {
            RwV3d vec = { x * progress, y * progress, z * progress };
            RwFrameTranslate(frame, &vec, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E00, progress * ax, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E0C, progress * ay, rwCOMBINEPRECONCAT);
            RwFrameRotate(frame, (RwV3d*)0x008D2E18, progress * az, rwCOMBINEPRECONCAT);
        }
        RwFrameUpdateObjects(frame);
    }
}

