namespace FindDamage
{
    static RwFrame* __cdecl CustomFindDamageAtomicsCB(RwFrame* frame, void* data)
    {
        RwFrameForAllObjects(frame, (RwObjectCallBack)0x4C7BD0, data);
        if (*(uint32_t*)data > 0 && *((uint32_t*)data + 1) > 0)
            return frame;
        RwFrameForAllChildren(frame, CustomFindDamageAtomicsCB, data);
        return frame;
    }

    static RwFrame* __cdecl CustomFindDamageAtomics(RwFrame* frame, RwFrame* (__cdecl* callback)(RwFrame*, void*), void* data)
    {
        if (!callback(frame, data))
            return frame;
        RwFrame* child = frame->child;
        if (child)
        {
            do
            {
                RwFrame* next = child->next;
                if (!callback(child, data))
                    break;
                child = next;
            } while (child);
        }
        return frame;
    }
}

// Junior CheckCrashFillFrameArrayCB — exact
static int __cdecl CheckCrashFillFrameArrayCB(RwFrame* frame)
{
    int id = CVisibilityPlugins::GetFrameHierarchyId(frame);
    if (id >= 25)
    {
        CVisibilityPlugins::SetFrameHierarchyId(frame, 0);
        return 0;
    }
    return id;
}


