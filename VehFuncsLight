static char* GetFrameNodeName(RwFrame* frame)
{
    return ((char* (__cdecl*)(RwFrame*))0x72FB30)(frame);
}

static int Random(int min, int max)
{
    if (min >= max) return min;
    return min + (rand() % (max - min + 1));
}

// ============================================================
// Junior DestroyNodeHierarchyRecursive (Utilities.cpp) — exact
// ============================================================

static void DestroyNodeHierarchyRecursive(RwFrame* frame)
{
    RpAtomic* atomic = (RpAtomic*)GetFirstObject(frame);
    if (atomic != nullptr)
    {
        RpClump* clump = atomic->clump;
        RpClumpRemoveAtomic(clump, atomic);
        RpAtomicDestroy(atomic);
    }

    RwFrameDestroy(frame);

    if (RwFrame* newFrame = frame->child) DestroyNodeHierarchyRecursive(newFrame);
    if (RwFrame* newFrame = frame->next)  DestroyNodeHierarchyRecursive(newFrame);
}

