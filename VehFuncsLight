// Game audio helpers (Junior Characteristics.cpp)
static void CVehicle__CancelVehicleEngineSound(CAEVehicleAudioEntity* audio, int soundId)
{
    ((void(__thiscall*)(CAEVehicleAudioEntity*, int))0x4F55C0)(audio, soundId);
}

static int CAEVehicleAudioEntity__RequestBankSlot(int id)
{
    return ((int(__cdecl*)(int))0x4F4D10)(id);
}

static void CAEVehicleAudioEntity__StoppedUsingBankSlot(int id)
{
    ((void(__cdecl*)(int))0x4F4DF0)(id);
}

static void FindVehicleCharacteristicsFromNode(RwFrame* frame, CVehicle* vehicle)
{
    const string name = string(GetFrameNodeName(frame)).substr(0, 24);

    // Fast reject: characteristics always use '='
    if (name.find('=') == string::npos)
        return;

    ExtendedData& xdata = xData.Get(vehicle);

    // ---- _pj= paintjob / remap (Junior Characteristics.cpp)
    // Forms: _pj=1  _pj=1c  _pj=0-2  _pj=0-2c
    size_t found = name.find("_pj=");
    if (found != string::npos && found + 4 < name.length())
    {
        int paintjob = 0;
        bool preserveColor = false;
        int digit1 = name[found + 4] - '0';

        if (found + 5 < name.length() && name[found + 5] == '-')
        {
            int digit2 = (found + 6 < name.length()) ? (name[found + 6] - '0') : digit1;
            srand((unsigned)(xdata.randomSeed + xdata.randomSeedUsage));
            xdata.randomSeedUsage++;
            paintjob = Random(digit1, digit2);
            if (found + 7 < name.length() && name[found + 7] == 'c')
                preserveColor = true;
        }
        else
        {
            if (found + 5 < name.length() && name[found + 5] == 'c')
                preserveColor = true;
            paintjob = digit1;
        }

        xdata.paintjob = (int8_t)paintjob;
        xdata.flags.bPreservePaintjobColor = preserveColor ? 1 : 0;
    }

    // ---- _cl= colors
    found = name.find("_cl=");
    if (found != string::npos)
    {
        int j = 0;
        char s[32] = { 0 };
        stringstream ss(&name[found + 4]);
        while (j < 4 && ss.getline(s, sizeof(s), ','))
        {
            try {
                xdata.color[j] = stoi(s);
            }
            catch (const exception&) {
                xdata.color[j] = -1; // '-', empty, etc.
            }
            j++;
        }
    }

    // ---- _se= engine sound banks (Junior — applied immediately)
    // Forms: _se=81,80  (accelerate bank, decelerate bank)
    found = name.find("_se=");
    if (found != string::npos)
    {
        int i = 4;
        try {
            int sound1 = stoi(&name[found + i]);

            do {
                ++i;
                if ((found + i) >= 22)
                    break;
            } while (name[found + i] != ',');

            if ((found + i) <= 22 && name[found + i] == ',')
            {
                ++i;
                int sound2 = stoi(&name[found + i]);

                vehicle->m_vehicleAudio.m_nEngineAccelerateSoundBankId = (short)sound1;
                vehicle->m_vehicleAudio.m_nEngineDecelerateSoundBankId = (short)sound2;

                int soundId = 0;
                do
                    CVehicle__CancelVehicleEngineSound(&vehicle->m_vehicleAudio, soundId++);
                while (soundId < 12);

                CAEVehicleAudioEntity__StoppedUsingBankSlot(vehicle->m_vehicleAudio.m_nEngineBankSlotId);
                vehicle->m_vehicleAudio.m_nEngineBankSlotId =
                    (short)CAEVehicleAudioEntity__RequestBankSlot(sound2);
            }
        }
        catch (const exception&) {
            // malformed _se= — ignore
        }
    }
}

static void SetCharacteristicsInRender(CVehicle* vehicle)
{
    ExtendedData& xdata = xData.Get(vehicle);

    // Colors first (Junior order)
    if (xdata.color[0] >= 0)
        vehicle->m_nPrimaryColor = (uint8_t)xdata.color[0];
    if (xdata.color[1] >= 0)
        vehicle->m_nSecondaryColor = (uint8_t)xdata.color[1];
    if (xdata.color[2] >= 0)
        vehicle->m_nTertiaryColor = (uint8_t)xdata.color[2];
    if (xdata.color[3] >= 0)
        vehicle->m_nQuaternaryColor = (uint8_t)xdata.color[3];

    // Paintjob / remap — Junior: SetRemap(paintjob - 1), optional keep color
    if (xdata.paintjob > 0)
    {
        vehicle->bDontSetColourWhenRemapping = xdata.flags.bPreservePaintjobColor != 0;
        vehicle->SetRemap((int)xdata.paintjob - 1);
        if (vehicle->m_nRemapTxd >= 0)
        {
            CStreaming::RequestModel(vehicle->m_nRemapTxd + (int)txdIndexStart,
                (int)(eStreamingFlags::KEEP_IN_MEMORY | eStreamingFlags::PRIORITY_REQUEST));
            CStreaming::LoadAllRequestedModels(true);
        }
    }
}

// ============================================================
// FindNodes — Junior-style walk
// ============================================================

static void FindNodesRecursive(RwFrame* frame, CVehicle* vehicle)
{
    while (frame)
    {
        const string name = string(GetFrameNodeName(frame)).substr(0, 24);
        ExtendedData& xdata = xData.Get(vehicle);

        // Junior: scan characteristics on every node (_cl= etc.)
        FindVehicleCharacteristicsFromNode(frame, vehicle);

        if (name.length() >= 2 && name[0] == 'f' && name[1] == '_')
        {
            if (xdata.randomSeed != 0)
            {
                if (name.find("f_class") != string::npos)
                {
                    ProcessClassesRecursive(frame, vehicle, false);
                    if (RwFrame* tempFrame = frame->next)
                    {
                        frame = tempFrame;
                        continue;
                    }
                    break;
                }

                if (name.find("f_extras") != string::npos)
                {
                    if (frame->child)
                    {
                        srand(xdata.randomSeed + xdata.randomSeedUsage);
                        xdata.randomSeedUsage++;
                        ProcessExtraRecursive(frame, vehicle);
                    }
                }
            }

            // Variable wheels — f_wheel_**** (Junior)
            if (name.find("f_wheel") != string::npos)
            {
                for (int i = 0; i < 6; i++)
                {
                    if (!xdata.wheelFrame[i])
                    {
                        xdata.wheelFrame[i] = frame;
                        FRAME_EXTENSION(frame)->owner = vehicle;
                        break;
                    }
                }
            }

            // f_spoiler — hide when tuning spoiler installed
            if (name.find("f_spoiler") != string::npos)
            {
                xdata.spoilerFrames.push_back(frame);
                FRAME_EXTENSION(frame)->owner = vehicle;
            }

            // Functional hitch
            if (name.find("f_hitch") != string::npos)
            {
                xdata.hitchFrame = frame;
                FRAME_EXTENSION(frame)->owner = vehicle;
            }

            // Popup headlights — f_popl (left/0) / f_popr (right/1)
            if (name.find("f_pop") != string::npos)
            {
                if (CreateMatrixBackup(frame))
                {
                    FRAME_EXTENSION(frame)->owner = vehicle;
                    if (name.find("f_popl") != string::npos)
                        xdata.popupFrame[0] = frame;
                    else if (name.find("f_popr") != string::npos)
                        xdata.popupFrame[1] = frame;
                }
            }
        }

        if (RwFrame* child = frame->child)
            FindNodesRecursive(child, vehicle);
        if (RwFrame* next = frame->next)
            FindNodesRecursive(next, vehicle);
        return;
    }
}

// ============================================================
// Junior: paintjobs on digit-terminated vehicle names
// Wiki: [EN] Paintjobs on digit-terminated vehicles
// Files: nrg500_1.txd, at400_2.txd, etc. (underscore before number)
// Hook replaces game AssignRemapTxd @ call 0x5B62C2
// ============================================================

static void __cdecl CustomAssignRemapTxd(const char* txdName, uint16_t txdId)
{
    if (!txdName)
        return;

    size_t len = strlen(txdName);
    if (len <= 1)
        return;

    // Only TXDs whose name ends with a digit are paintjob candidates
    if (!isdigit((unsigned char)txdName[len - 1]))
        return;

    // Skip radar*.txd (Junior perf skip)
    if (len >= 5 && txdName[0] == 'r' && txdName[1] == 'a' && txdName[2] == 'd'
        && txdName[3] == 'a' && txdName[4] == 'r')
        return;

    // Strip trailing digits, and optional '_' before them:
    //   "nrg500_1" -> "nrg500"   |  "elegy1" -> "elegy" (vanilla style still works)
    do
    {
        len--;
        if (txdName[len] == '_')
        {
            len--;
            break;
        }
    } while (len > 0 && isdigit((unsigned char)txdName[len]));

    len++; // length of model base name

    char modelTxdName[32];
    if (len >= sizeof(modelTxdName))
        len = sizeof(modelTxdName) - 1;
    strncpy(modelTxdName, txdName, len);
    modelTxdName[len] = 0;

    // Resolve vehicle model by TXD base name (Junior)
    int modelId = -1;
    CBaseModelInfo* modelInfo = CModelInfo::GetModelInfo(modelTxdName, &modelId);

    if (!modelInfo)
    {
        uint32_t minVehModel = ReadMemory<uint32_t>(0x4C93CB + 1, true);
        uint32_t maxVehModel = ReadMemory<uint32_t>(0x4C93C2 + 1, true);
        modelInfo = CModelInfo::GetModelInfo(modelTxdName, (int)minVehModel, (int)maxVehModel);
    }

    // 6 = MODEL_INFO_VEHICLE (cars, bikes, trailers, …)
    if (modelInfo && modelInfo->GetModelType() == 6)
    {
        CVehicleModelInfo* vehModelInfo = (CVehicleModelInfo*)modelInfo;
        vehModelInfo->AddRemap(txdId);
    }
}

